{
  "version": 2,
  "builds": [
    {
      "src": "server-authenticated.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server-authenticated.js"
    },
    {
      "src": "/upload",
      "dest": "/server-authenticated.js"
    },
    {
      "src": "/pricing",
      "dest": "/server-authenticated.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server-authenticated.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
